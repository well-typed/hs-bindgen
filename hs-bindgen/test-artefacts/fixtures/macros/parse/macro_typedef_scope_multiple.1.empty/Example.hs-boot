{-# LANGUAGE NoImplicitPrelude #-}

module Example where

import qualified HsBindgen.Runtime.Marshal as Marshal
import qualified HsBindgen.Runtime.Support as BG
import Prelude (Bounded, Enum, Eq, Integral, Num, Ord, Read, Real, Show)

data T2

instance Eq T2

instance BG.Generic T2

instance Ord T2

instance Read T2

instance Show T2

instance BG.Bitfield T2

instance BG.Bits T2

instance Bounded T2

instance Enum T2

instance BG.FiniteBits T2

instance BG.HasFFIType T2

instance Integral T2

instance BG.Ix T2

instance Num T2

instance BG.Prim T2

instance Marshal.ReadRaw T2

instance Real T2

instance Marshal.StaticSize T2

instance BG.Storable T2

instance Marshal.WriteRaw T2

data T4

instance Eq T4

instance BG.Generic T4

instance Ord T4

instance Read T4

instance Show T4

instance BG.Bitfield T4

instance BG.Bits T4

instance Bounded T4

instance Enum T4

instance BG.FiniteBits T4

instance BG.HasFFIType T4

instance Integral T4

instance BG.Ix T4

instance Num T4

instance BG.Prim T4

instance Marshal.ReadRaw T4

instance Real T4

instance Marshal.StaticSize T4

instance BG.Storable T4

instance Marshal.WriteRaw T4
