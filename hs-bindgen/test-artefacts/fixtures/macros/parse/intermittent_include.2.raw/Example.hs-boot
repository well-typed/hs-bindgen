{-# LANGUAGE NoImplicitPrelude #-}

module Example where

import qualified HsBindgen.Runtime.Marshal as Marshal
import qualified HsBindgen.Runtime.Support as BG
import Prelude (Bounded, Enum, Eq, Integral, Num, Ord, Read, Real, Show)

data Ta

instance Eq Ta

instance BG.Generic Ta

instance Ord Ta

instance Read Ta

instance Show Ta

instance BG.Bitfield Ta

instance BG.Bits Ta

instance Bounded Ta

instance Enum Ta

instance BG.FiniteBits Ta

instance BG.HasFFIType Ta

instance Integral Ta

instance BG.Ix Ta

instance Num Ta

instance BG.Prim Ta

instance Marshal.ReadRaw Ta

instance Real Ta

instance Marshal.StaticSize Ta

instance BG.Storable Ta

instance Marshal.WriteRaw Ta

data T1

instance Eq T1

instance BG.Generic T1

instance Ord T1

instance Read T1

instance Show T1

instance BG.Bitfield T1

instance BG.Bits T1

instance Bounded T1

instance Enum T1

instance BG.FiniteBits T1

instance BG.HasFFIType T1

instance Integral T1

instance BG.Ix T1

instance Num T1

instance BG.Prim T1

instance Marshal.ReadRaw T1

instance Real T1

instance Marshal.StaticSize T1

instance BG.Storable T1

instance Marshal.WriteRaw T1

data T2

instance Eq T2

instance BG.Generic T2

instance Ord T2

instance Read T2

instance Show T2

instance BG.Bitfield T2

instance BG.Bits T2

instance Bounded T2

instance Enum T2

instance BG.FiniteBits T2

instance BG.HasFFIType T2

instance Integral T2

instance BG.Ix T2

instance Num T2

instance BG.Prim T2

instance Marshal.ReadRaw T2

instance Real T2

instance Marshal.StaticSize T2

instance BG.Storable T2

instance Marshal.WriteRaw T2
