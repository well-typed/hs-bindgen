-- This project file can be used during development, when compilation speed
-- matters more than execution speed.
--
-- cabal build all --project-file cabal.project.fast --builddir dist-newstyle-fast
--
-- Give this project file a build directory of its own. The local packages are
-- registered in <builddir>/packagedb under their package name alone, so a
-- build directory shared with cabal.project holds a single registration for
-- both: whichever project file built last wins, and builds using the other one
-- then silently link against a library built with the other optimisation
-- setting. `builddir` is ignored inside project files, so it has to be passed
-- on the command line.
import: cabal.project

-- Step 1: tuning GHC
program-options
   ghc-options: +RTS -A64m -RTS

-- Step 2: disable optimizations
optimization: False

-- Step 3: build parallelism
jobs: 6
semaphore: True
