cabal-version:   3.0
name:            c-direct-optimization
version:         0.1.0
synopsis:        Sequence alignment via the POY direct-optimization C library

-- The Haskell code is BSD-3-Clause, as elsewhere in hs-bindgen. The vendored C
-- library in direct-optimization/ is third-party, under its own licence; see
-- direct-optimization/COPYRIGHT and README.md.
license:         BSD-3-Clause
license-file:    LICENSE
author:          Well-Typed LLP
maintainer:      info@well-typed.com
build-type:      Simple

common lang
  build-depends:    base >=4.17 && <5
  default-language: GHC2021
  ghc-options:      -Wall -Wunused-packages

  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    ImportQualifiedPost
    LambdaCase
    RoleAnnotations
    ScopedTypeVariables
    UnicodeSyntax

library
  import:          lang
  hs-source-dirs:  src generated

  -- The vendored C library is compiled directly into the package rather than
  -- linked as a shared library; see bundled-c for the same approach.
  include-dirs:    direct-optimization
  c-sources:
    direct-optimization/alignCharacters.c
    direct-optimization/alignmentMatrices.c
    direct-optimization/c_alignment_interface.c
    direct-optimization/c_code_alloc_setup.c
    direct-optimization/costMatrix.c
    direct-optimization/dyn_character.c

  exposed-modules:
    -- Generated by ../generate-and-run.sh -- do not edit by hand.
    DirectOptimization

    -- Hand-written: the two modules that use the generated bindings.
    CostMatrix
    StringAlignment

    -- Hand-written support code.
    Example.Alphabet
    Example.Alphabet.Codec
    Example.Alphabet.Gap
    Example.Alphabet.Internal
    Example.Alphabet.IUPAC
    Example.CharacterElement
    Example.CharacterSequence
    Example.Measure

  build-depends:
    , bimap
    , bitvec
    , containers
    , deepseq
    , hashable
    , hs-bindgen-runtime
    , monad-loops
    , mtl
    , primitive
    , vector

executable c-direct-optimization-bin
  import:         lang
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
    , bimap
    , c-direct-optimization
    , containers
    , vector
