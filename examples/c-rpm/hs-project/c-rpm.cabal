cabal-version:   3.0
name:            c-rpm
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
author:          Well-Typed LLP
maintainer:      info@well-typed.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall -Wunused-packages

library
  import:             warnings
  exposed-modules:
    RPM.Argv
    RPM.Argv.FunPtr
    RPM.Argv.Safe
    RPM.Argv.Unsafe
    RPM.Header
    RPM.Header.FunPtr
    RPM.Header.Safe
    RPM.Header.Unsafe
    RPM.Rpmds
    RPM.Rpmds.FunPtr
    RPM.Rpmds.Safe
    RPM.Rpmds.Unsafe
    RPM.Rpmio
    RPM.Rpmio.FunPtr
    RPM.Rpmio.Safe
    RPM.Rpmio.Unsafe
    RPM.Rpmlib
    RPM.Rpmlib.FunPtr
    RPM.Rpmlib.Safe
    RPM.Rpmlib.Unsafe
    RPM.Rpmprob
    RPM.Rpmprob.FunPtr
    RPM.Rpmprob.Safe
    RPM.Rpmprob.Unsafe
    RPM.Rpmps
    RPM.Rpmps.FunPtr
    RPM.Rpmps.Safe
    RPM.Rpmps.Unsafe
    RPM.Rpmsw
    RPM.Rpmsw.FunPtr
    RPM.Rpmsw.Safe
    RPM.Rpmsw.Unsafe
    RPM.Rpmtag
    RPM.Rpmtag.FunPtr
    RPM.Rpmtag.Safe
    RPM.Rpmtag.Unsafe
    RPM.Rpmtd
    RPM.Rpmtd.FunPtr
    RPM.Rpmtd.Safe
    RPM.Rpmtd.Unsafe
    RPM.Rpmtypes
    RPM.Rpmutil
    RPM.Rpmutil.FunPtr
    RPM.Rpmutil.Safe
    RPM.Rpmutil.Unsafe
    RPM.Rpmver

  build-depends:
    , base
    , hs-bindgen-runtime

  hs-source-dirs:     src
  default-language:   Haskell2010
  extra-libraries:
    rpmbuild
    rpmio

  default-extensions:
    FlexibleInstances
    ImportQualifiedPost

executable c-rpm
  import:             warnings
  main-is:            Main.hs
  build-depends:
    , base
    , c-rpm
    , hs-bindgen-runtime

  hs-source-dirs:     app
  default-language:   Haskell2010
  default-extensions: ImportQualifiedPost
