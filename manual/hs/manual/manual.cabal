cabal-version: 3.0
name:          manual
version:       0.1.0
license:       BSD-3-Clause
license-file:  LICENSE
author:        Well-Typed LLP
maintainer:    info@well-typed.com
build-type:    Simple

common lang
  ghc-options:
    -Wall -Widentities -Wredundant-constraints -Wunused-packages
    -Wno-unticked-promoted-constructors

  default-language:   GHC2021
  build-depends:      base >=4.16 && <5
  default-extensions:
    DerivingVia
    LambdaCase

executable run-manual
  import:         lang
  main-is:        Manual.hs
  other-modules:
    Manual.BindingSpecifications
    Manual.Functions.FirstOrder
    Manual.Functions.HigherOrder
    Manual.GeneratedNames
    Manual.GeneratedNames.UnprefixedFieldNames
    Manual.Globals
    Manual.Macros
    Manual.PointerManipulation
    Manual.Tools
    Manual.Types.Arrays
    Manual.Types.Complex
    Manual.Types.Enums
    Manual.Types.Structs
    Manual.Types.Typedefs
    Manual.Types.Unions

  ghc-options:    -main-is Manual
  hs-source-dirs: app

  -- Inherited
  build-depends:  hs-bindgen-runtime

  -- Internal
  build-depends:  manual:generated

  -- External
  build-depends:
    , bytestring
    , hs-game
    , hs-vector
    , optics
    , vector

library generated
  import:          lang
  visibility:      private
  hs-source-dirs:  generated
  extra-libraries: manual

  -- External
  build-depends:
    , c-expr-runtime
    , hs-bindgen-runtime

  exposed-modules:
    Arrays
    Arrays.Global
    Arrays.Safe
    Callbacks
    Callbacks.FunPtr
    Callbacks.Safe
    Callbacks.Unsafe
    Complex
    Complex.Global
    Complex.Safe
    Example
    Example.Unsafe
    FunctionPointers
    FunctionPointers.FunPtr
    FunctionPointers.Global
    FunctionPointers.Safe
    GeneratedNames
    GeneratedNames.UnprefixedFieldNames
    GeneratedNames.Unsafe
    Globals
    Globals.Global
    Macro
    Macro.Unsafe
    PointerManipulation
    Structs
    Structs.Nesting
    Structs.Safe
    Unions
    Unions.FunPtr
    Unions.Nesting
    Unions.Safe
    Unions.Unsafe

  -- Avoid gcc warnings about non-NFC characters
  -- See <https://github.com/well-typed/hs-bindgen/issues/918>
  ghc-options:     -optc -Wno-normalized
